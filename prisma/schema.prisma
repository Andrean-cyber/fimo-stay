// ============================================================
// FimoStay — schema.prisma (MVP)
// Database: Supabase Postgres
// Catatan: AdminProfile.id harus sama dengan id di auth.users
// (Supabase Auth) — dibuat lewat trigger/hook saat admin dibuat,
// bukan dikelola Prisma langsung karena auth.users di schema lain.
// ============================================================

generator client {
  provider = "prisma-client-js"

}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")      // connection pooler (pgbouncer), dipakai runtime
  directUrl = env("DIRECT_URL")        // direct connection, dipakai untuk migration
}

// ------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------

enum AdminRole {
  SUPERADMIN
  STAFF
}

enum KosStatus {
  ACTIVE        // tampil di publik
  HIDDEN_STALE  // disembunyikan otomatis (belum update > 7 hari)
  HIDDEN_MANUAL // disembunyikan manual oleh tim (mis. kamar penuh permanen)
}

enum TransactionType {
  SELF_SEARCH    // Rp30rb — buka kontak 1 kos
  RECOMMENDATION // Rp90rb — 3 rekomendasi kos
}

enum TransactionStatus {
  PENDING
  VERIFIED
  REJECTED
}

// ------------------------------------------------------------
// ADMIN / TIM
// ------------------------------------------------------------

model AdminProfile {
  id        String    @id // sama dengan auth.users.id di Supabase Auth
  fullName  String
  email     String    @db.VarChar(255) @unique
  role      AdminRole @default(STAFF)
  createdAt DateTime  @default(now())

  updatedKos           Kos[]           @relation("KosUpdatedBy")
  verifiedTransactions Transaction[]   @relation("TransactionVerifiedBy")
  auditLogs            AuditLog[]

  @@map("admin_profiles")
}

// ------------------------------------------------------------
// OWNER & KOS
// ------------------------------------------------------------

model Owner {
  id        String   @id @default(uuid())
  name      String
  phone     String
  address   String?
  notes     String?  // catatan internal tim, tidak tampil ke publik
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kos Kos[]

  @@map("owners")
}

model Kos {
  id            String    @id @default(uuid())
  slug          String    @unique
  name          String
  description   String?
  address       String
  city          String
  latitude      Float?
  longitude     Float?
  priceMonthly  Int       // dalam rupiah
  roomType      String?   // "putra" | "putri" | "campur"
  facilities    String[]  @default([])
  status        KosStatus @default(ACTIVE)

  ownerId String
  owner   Owner  @relation(fields: [ownerId], references: [id])

  media KosMedia[]

  lastUpdatedAt DateTime @default(now()) // dipakai cron auto-hide 7 hari
  updatedById   String?
  updatedBy     AdminProfile? @relation("KosUpdatedBy", fields: [updatedById], references: [id])

  selfSearchTransactions Transaction[]         @relation("TransactionTargetKos")
  recommendationItems    RecommendationItem[]
  auditLogs              AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([city])
  @@index([lastUpdatedAt])
  @@map("kos")
}

model KosMedia {
  id        String   @id @default(uuid())
  kosId     String
  kos       Kos      @relation(fields: [kosId], references: [id], onDelete: Cascade)
  url       String   // path/object key di Cloudflare R2
  isCover   Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([kosId])
  @@map("kos_media")
}

// ------------------------------------------------------------
// PENCARI KOS
// ------------------------------------------------------------

model Searcher {
  id        String   @id @default(uuid())
  phone     String
  name      String?
  createdAt DateTime @default(now())

  transactions Transaction[]

  @@index([phone])
  @@map("searchers")
}

// ------------------------------------------------------------
// TRANSAKSI (pembayaran manual)
// ------------------------------------------------------------

model Transaction {
  id     String             @id @default(uuid())
  type   TransactionType
  amount Int                // 30000 atau 90000
  status TransactionStatus  @default(PENDING)

  proofUrl String? // bukti transfer, path di R2

  searcherId String
  searcher   Searcher @relation(fields: [searcherId], references: [id])

  // dipakai kalau type = SELF_SEARCH (kos yang mau dibuka kontaknya)
  targetKosId String?
  targetKos   Kos?    @relation("TransactionTargetKos", fields: [targetKosId], references: [id])

  // dipakai kalau type = RECOMMENDATION
  preferenceNotes      String? // budget, lokasi, tipe kamar, dst (bebas teks/JSON)
  recommendationToken  String? @unique // dipakai di URL /rekomendasi/[token]

  verifiedById String?
  verifiedBy   AdminProfile? @relation("TransactionVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt   DateTime?

  createdAt DateTime @default(now())

  recommendationItems RecommendationItem[]
  auditLogs           AuditLog[]

  @@index([status])
  @@index([type])
  @@map("transactions")
}

model RecommendationItem {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  kosId         String
  kos           Kos         @relation(fields: [kosId], references: [id])
  order         Int         @default(0)
  createdAt     DateTime    @default(now())

  @@unique([transactionId, kosId])
  @@map("recommendation_items")
}

// ------------------------------------------------------------
// AUDIT LOG
// ------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  entityType String   // "kos" | "owner" | "transaction"
  entityId   String
  action     String   // "create" | "update" | "hide" | "verify" | "reject"
  changes    Json?    // simpan diff sebelum/sesudah kalau perlu

  kosId String?
  kos   Kos?   @relation(fields: [kosId], references: [id])

  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  adminId String?
  admin   AdminProfile? @relation(fields: [adminId], references: [id])

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}
