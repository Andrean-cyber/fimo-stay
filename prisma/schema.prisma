// ============================================================
// FimoStay — schema.prisma (MVP + Segment/RoomType structure)
// Database: Supabase Postgres
// Catatan: AdminProfile.id harus sama dengan id di auth.users
// (Supabase Auth) — dibuat lewat trigger/hook saat admin dibuat,
// bukan dikelola Prisma langsung karena auth.users di schema lain.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")      // connection pooler (pgbouncer), dipakai runtime
  directUrl = env("DIRECT_URL")        // direct connection, dipakai untuk migration
}

// ------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------

enum AdminRole {
  SUPERADMIN
  STAFF
}

enum KosStatus {
  ACTIVE        // tampil di publik
  HIDDEN_STALE  // disembunyikan otomatis (belum update > 7 hari)
  HIDDEN_MANUAL // disembunyikan manual oleh tim (mis. kamar penuh permanen)
}

enum TransactionType {
  SELF_SEARCH    // Rp30rb — buka kontak 1 kos
  RECOMMENDATION // Rp90rb — 3 rekomendasi kos
}

enum TransactionStatus {
  PENDING
  VERIFIED
  REJECTED
}

// ------------------------------------------------------------
// ADMIN / TIM
// ------------------------------------------------------------

model AdminProfile {
  id        String    @id // sama dengan auth.users.id di Supabase Auth
  fullName  String
  email     String    @db.VarChar(255) @unique
  role      AdminRole @default(STAFF)
  createdAt DateTime  @default(now())

  updatedKos           Kos[]           @relation("KosUpdatedBy")
  verifiedTransactions Transaction[]   @relation("TransactionVerifiedBy")
  auditLogs            AuditLog[]
  sentTransactions Transaction[] @relation("TransactionSentBy")

  @@map("admin_profiles")
}

// ------------------------------------------------------------
// OWNER & KOS
// ------------------------------------------------------------

model Owner {
  id        String   @id @default(uuid())
  name      String
  phone     String
  address   String?
  notes     String?  // catatan internal tim, tidak tampil ke publik
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kos Kos[]

  @@map("owners")
}

model Kos {
  id           String    @id @default(uuid())
  slug         String    @unique
  name         String
  description  String?
  city         String    // tampil publik sebelum bayar
  district String?
  address      String    // alamat lengkap — TIDAK pernah di-select di query publik,
                          // baru boleh diambil setelah ada Transaction VERIFIED milik searcher utk kos ini
  latitude     Float?
  longitude    Float?
  facilities   String[]  @default([])
  status       KosStatus @default(ACTIVE)

  ownerId String
  owner   Owner  @relation(fields: [ownerId], references: [id])

  media    KosMedia[]
  segments KosSegment[]
  nearby   KosNearby[]

  lastUpdatedAt DateTime @default(now()) // dibump manual tiap kali segment/roomtype/nearby berubah — dipakai cron auto-hide 7 hari
  updatedById   String?
  updatedBy     AdminProfile? @relation("KosUpdatedBy", fields: [updatedById], references: [id])

  selfSearchTransactions Transaction[]         @relation("TransactionTargetKos")
  recommendationItems    RecommendationItem[]
  auditLogs              AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([city])
  @@index([lastUpdatedAt])
  @@map("kos")
}

model KosMedia {
  id        String   @id @default(uuid())
  kosId     String
  kos       Kos      @relation(fields: [kosId], references: [id], onDelete: Cascade)
  url       String   // path/object key di Cloudflare R2
  isCover   Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([kosId])
  @@map("kos_media")
}

// ------------------------------------------------------------
// JENIS KOS (master, dipakai filter pencarian publik)
// Putra | Putri | Campur | Putra & Putri | LV | Pasutri, dst
// ------------------------------------------------------------

model KosType {
  id   String @id @default(uuid())
  name String @unique

  segments KosSegment[]

  createdAt DateTime @default(now())

  @@map("kos_types")
}

// ------------------------------------------------------------
// SEGMENT — mewakili "gedung" / bagian kos dengan 1 jenis kos.
// 1 Kos bisa punya 1 segment (kasus umum) atau lebih (mis. Kos A
// gedung Putra terpisah dari gedung Putri).
// Sengaja TIDAK @@unique([kosId, kosTypeId]) supaya bisa ada
// 2 segment dengan kosType sama kalau memang dibutuhkan.
// ------------------------------------------------------------

model KosSegment {
  id String @id @default(uuid())

  kosId String
  kos   Kos    @relation(fields: [kosId], references: [id], onDelete: Cascade)

  kosTypeId String
  kosType   KosType @relation(fields: [kosTypeId], references: [id])

  name String? // opsional, misal "Gedung Putra" — null kalau cuma 1 segment

  roomTypes KosRoomType[]

  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kosId])
  @@index([kosTypeId])
  @@map("kos_segments")
}

// ------------------------------------------------------------
// TIPE KAMAR — bebas per kos/segment, TANPA master (admin bisa
// bikin nama custom, edit, hapus kapan saja). Harga & availability
// nempel di sini, bukan di Kos.
// ------------------------------------------------------------

model KosRoomType {
  id String @id @default(uuid())

  segmentId String
  segment   KosSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  name           String   // bebas: "Standard", "Deluxe", "VIP", "Kamar Belakang", dst
  priceMonthly   Int      // dalam rupiah
  totalRooms     Int?
  availableRooms Int?
  description    String?
  facilities     String[] @default([])
  isActive       Boolean  @default(true)
  order          Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([segmentId])
  @@index([isActive])
  @@map("kos_room_types")
}

// ------------------------------------------------------------
// NEARBY — diinput manual per kos (mis. "2 menit ke UB").
// Tidak ada tabel master kampus/tempat untuk MVP.
// ------------------------------------------------------------

model KosNearby {
  id String @id @default(uuid())

  kosId String
  kos   Kos    @relation(fields: [kosId], references: [id], onDelete: Cascade)

  name         String  // "Universitas Brawijaya", "Indomaret", dst
  distanceText String  // teks bebas: "2 menit", "1.2 km"
  category     String? // opsional: "kampus" | "minimarket" | dst, buat filter nanti
  isActive     Boolean @default(true)
  order        Int     @default(0)

  createdAt DateTime @default(now())

  @@index([kosId])
  @@map("kos_nearby")
}

// ------------------------------------------------------------
// PENCARI KOS
// ------------------------------------------------------------

model Searcher {
  id        String   @id @default(uuid())
  phone     String
  name      String?
  createdAt DateTime @default(now())

  transactions Transaction[]

  @@index([phone])
  @@map("searchers")
}

// ------------------------------------------------------------
// TRANSAKSI (pembayaran manual)
// ------------------------------------------------------------

model Transaction {
  id     String             @id @default(uuid())
  type   TransactionType
  amount Int                // 40000 atau 100000
  status TransactionStatus  @default(PENDING)

  proofUrl String? // bukti transfer, path di R2

  searcherId String
  searcher   Searcher @relation(fields: [searcherId], references: [id])

  // dipakai kalau type = SELF_SEARCH (kos yang mau dibuka kontaknya/alamatnya)
  targetKosId String?
  targetKos   Kos?    @relation("TransactionTargetKos", fields: [targetKosId], references: [id])

  // dipakai kalau type = RECOMMENDATION
  preferenceNotes Json? // budget, lokasi, tipe kamar, dst (bebas teks/JSON)
  recommendationToken  String? @unique // dipakai di URL /rekomendasi/[token]

  verifiedById String?
  verifiedBy   AdminProfile? @relation("TransactionVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt   DateTime?

  sentAt   DateTime?
  sentById String?
  sentBy   AdminProfile? @relation("TransactionSentBy", fields: [sentById], references: [id])

  createdAt DateTime @default(now())

  recommendationItems RecommendationItem[]
  auditLogs           AuditLog[]

  @@index([status])
  @@index([type])
  @@map("transactions")
}

model RecommendationItem {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  kosId         String
  kos           Kos         @relation(fields: [kosId], references: [id])
  order         Int         @default(0)
  createdAt     DateTime    @default(now())

  @@unique([transactionId, kosId])
  @@map("recommendation_items")
}

// ------------------------------------------------------------
// AUDIT LOG
// ------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  entityType String   // "kos" | "owner" | "transaction" | "kos_segment" | "kos_room_type"
  entityId   String
  action     String   // "create" | "update" | "hide" | "verify" | "reject" | "delete"
  changes    Json?    // simpan diff sebelum/sesudah kalau perlu

  kosId String?
  kos   Kos?   @relation(fields: [kosId], references: [id])

  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  adminId String?
  admin   AdminProfile? @relation(fields: [adminId], references: [id])

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}
